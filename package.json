{
  "name": "dsh-transparent-ui",
  "description": "Aqua glassmorphism theme for DeepSeek Harness 0.2.0-rc.2",
  "version": "1.3.20",
  "icon": "icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fegnze/dsh-transparent-ui.git"
  },
  "homepage": "https://github.com/fegnze/dsh-transparent-ui",
  "bugs": {
    "url": "https://github.com/fegnze/dsh-transparent-ui/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "files": ["cordis.patch.yml"],
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-invariants"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/toolbar.browser.mjs"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "dsh": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "happy-dom": "^20.0.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-test-runtime": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@tsdown/css": "0.22.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tinyexec": "1.2.4",
    "@rolldown/pluginutils": "1.0.1"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "icon.svg"
  ]
}
